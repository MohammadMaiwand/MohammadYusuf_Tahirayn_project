# Copy to backend/.env; never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/myt_system
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# JWT_SECRET=replace-with-at-least-32-random-characters-before-enabling-auth
JWT_ISSUER=myt-system
JWT_AUDIENCE=myt-client
OFFLINE_SYNC_ENABLED=false
APP_TIMEZONE=Asia/Kabul
APP_CALENDAR=persian
# Optional existing local Windows service name, consumed only by launcher:
MONGODB_SERVICE_NAME=
