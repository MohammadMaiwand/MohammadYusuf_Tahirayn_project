# Copy to backend/.env; never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/myt_system?replicaSet=myt-dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
# JWT_SECRET=replace-with-at-least-32-random-characters-before-enabling-auth
JWT_ISSUER=myt-system
JWT_AUDIENCE=myt-client
# Generated locally by scripts/database/setup-accounts.mjs; never commit private keys.
# AUTH_PRIVATE_KEY=base64-ed25519-pkcs8-private-key
OFFLINE_SYNC_ENABLED=false
DEV_IDENTITY_ENABLED=false
DEV_ROLE=admin
DEV_BRANCH_ID=sham-royal
# Opt in only for the isolated local development replica set (never production).
MONGODB_DEV_MANAGED=false
APP_TIMEZONE=Asia/Kabul
APP_CALENDAR=persian
# Optional existing local Windows service name, consumed only by launcher:
MONGODB_SERVICE_NAME=
